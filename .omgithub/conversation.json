;ctx.scale(-1,1);ctx.drawImage(video, -160,0,160,120);ctx.restore();const data=ctx.getImageData(0,0,160,120).data;let motion=0;if(prev){for(let i=0;i<data.length;i+=64){const d=Math.abs(data[i]-prev[i])+Math.abs(data[i+1]-prev[i+1])+Math.abs(data[i+2]-prev[i+2]);motion+=d}}prev=data.slice();if(motion>8500){score=Math.min(100,score+3);target.classList.add('bad')}else{score=Math.max(0,score-1);target.classList.remove('bad')}document.querySelector('#status').innerHTML=motion>8500?'STATUS: <b>MOVIMENTO DETECTADO</b>':'STATUS: <b>GESTO RECONHECIDO</b>';if(score>65&&motion>8500)setTimeout(()=>{if(score>65)cast()},650);requestAnimationFrame(trackMotion)}\nfunction cast(){const names=['RAIJIN • IMPACTO','KAZE • CORTE','YAMI • EXPLOSÃO'],dmg=[10,8,16];callout.textContent=names[selected];callout.classList.remove('show');void callout.offsetWidth;callout.classList.add('show');burst.classList.remove('fire');void burst.offsetWidth;burst.classList.add('fire');flash.classList.remove('on');void flash.offsetWidth;flash.classList.add('on');enemy=Math.max(0,enemy-dmg[selected]);document.querySelector('#enemyHealth').style.width=enemy+'%';energy=Math.max(8,energy-dmg[selected]*1.3);document.querySelector('#energy').style.width=energy+'%';combo++;document.querySelector('#combo').textContent='x'+combo;document.querySelector('#dot4').classList.toggle('on',combo%2===0);document.querySelector('#fighterLeft').animate([{transform:'translateX(0)'},{transform:'translateX(30px) scale(1.04)'},{transform:'translateX(0)'}],{duration:350});if(enemy===0){setTimeout(()=>{enemy=100;document.querySelector('#enemyHealth').style.width='100%';callout.textContent='K.O.!';callout.classList.add('show';},500)}}\ndocument.querySelector('#cast').onclick=cast;\nwindow.addEventListener('keydown',e=>{if(e.key===' '){e.prevent();cast()}if(['1','w','W'].includes(e.key))select(0);if(['2','a','A'].includes(e.key))select(1);if(['3','s','S'].includes(e.key))select(2)});\n</script>\n</body>\n</html>"},"content":[{"type":"t